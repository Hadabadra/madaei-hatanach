{
  "id": "com.chadbedera.madaeihatanach",
  "name": "עינים למקרא",
  "version": "5.4.0",
  "description": "מדריך מאוחד לתנ״ך ומשנה/תלמוד: אישים, מקומות, בע״ח, צומח, דומם, בית המקדש, אנשים מהתלמוד ומסכתות — זיהוי אחיד בלחיצה ימנית, תמונות ומפה בלי אינטרנט.",
  "author": "חד בדרא",
  "homepage": "https://github.com/Hadabadra/madaei-hatanach",
  "schemaVersion": 1,
  "sdkVersion": "1.x",
  "stability": "stable",
  "minAppVersion": "0.9.98",
  "icon": "icon/icon.png",
  "entrypoint": "index.html",
  "permissions": [
    "reader.context_menu",
    "reader.open",
    "reader.toolbar",
    "published_data.write",
    "app.run_on_startup",
    "app.startup_contributions",
    "notifications.send",
    "app.open_url",
    "navigation.write",
    "plugin.storage.read",
    "library.books.read",
    "library.content.read",
    "network.access",
    "network.localhost",
    "tools.read",
    "search.fulltext.read",
    "app.shortcuts",
    "ui.create_shortcut",
    "reader.highlight",
    "events.subscribe:reader.selection_changed",
    "bookmarks.write",
    "search.dialog",
    "library.books.provide",
    "library.links.read",
    "calendar.read",
    "events.subscribe:calendar.date_changed",
    "notifications.system",
    "notes.write",
    "feedback.send_email",
    "events.subscribe:reader.current_ref_changed",
    "events.subscribe:reader.current_book_changed",
    "bookmarks.read",
    "workspace.manage",
    "plugin.open_other",
    "fs.user_files.read",
    "fs.user_files.write",
    "events.subscribe:workspace.changed"
  ],
  "network": {
    "enabled": true,
    "allowlist": [
      "https://tiles.maps.eox.at/",
      "https://raw.githubusercontent.com/Hadabadra/madaei-hatanach/main/manifest.json",
      "https://raw.githubusercontent.com/e0548433917-gif/madaei-hatanach/main/manifest.json",
      "https://api.github.com/repos/Hadabadra/madaei-hatanach/contents/manifest.json",
      "https://api.github.com/repos/e0548433917-gif/madaei-hatanach/contents/manifest.json",
      "https://github.com/Hadabadra/madaei-hatanach/releases",
      "https://github.com/e0548433917-gif/madaei-hatanach/releases",
      "https://script.google.com/macros/s/AKfycbxzlCAZzhaEM68jRqqekW8InrtbSiZrtiiIjgCKOInUvyBG43wLY29MYY6PrbHijpO6/exec",
      "https://script.googleusercontent.com/macros/echo",
      "https://docs.google.com/forms/d/e/1FAIpQLSd7NiGDUahnwpaestosEcDxPJoAkYXzVRUa2yB5EiXkLPSWvQ/formResponse",
      "https://he.wikipedia.org/api/rest_v1/page/summary",
      "http://127.0.0.1:5000",
      "http://127.0.0.1:5001",
      "http://127.0.0.1:5002",
      "http://127.0.0.1:5003",
      "http://127.0.0.1:5004",
      "http://127.0.0.1:5005",
      "http://127.0.0.1:5006",
      "http://127.0.0.1:5007",
      "http://127.0.0.1:5008",
      "http://127.0.0.1:5009",
      "http://127.0.0.1:5010"
    ]
  },
  "contributes": {
    "background": {
      "entrypoint": "background.html"
    },
    "toolTab": {
      "title": "עינים למקרא",
      "order": 40,
      "defaultPinned": true,
      "iconName": "eye_24_regular"
    },
    "startup": {
      "contextMenuItems": [
        {
          "id": "madaei-hatanach-identify",
          "type": "item",
          "title": "זיהוי בעינים למקרא",
          "icon": "search_24_regular",
          "contexts": [
            "reader-selection"
          ]
        }
      ],
      "toolbarItems": [
        {
          "id": "madaei-hatanach-open",
          "type": "button",
          "title": "עינים למקרא",
          "icon": "eye_24_regular",
          "contexts": [
            "reader-text"
          ],
          "openPlugin": true,
          "when": {
            "storage": {
              "key": "mh_hide_toolbar_button",
              "notEquals": true
            }
          }
        }
      ],
      "activationEvents": [
        "app.startup",
        {
          "topic": "reader.selection_changed",
          "when": {
            "storage": {
              "key": "mh_auto_identify",
              "equals": true
            }
          }
        },
        {
          "topic": "workspace.changed",
          "when": {
            "storage": {
              "key": "mh_pending_ws_flag",
              "equals": true
            }
          }
        }
      ],
      "keepAlive": false,
      "shortcuts": [
        {
          "id": "madaei-hatanach-identify-shortcut",
          "label": "זיהוי בעינים למקרא",
          "key": "ctrl+alt+i",
          "contextMenuItemId": "madaei-hatanach-identify"
        }
      ],
      "searchDialogItems": [
        {
          "id": "madaei-hatanach-search",
          "type": "checkbox",
          "title": "חפש גם בעינים למקרא (אישים, מקומות, צומח, בע״ח ועוד)",
          "defaultValue": false,
          "openPluginOnSubmit": true,
          "visibleInModes": [
            "exact",
            "advanced"
          ]
        }
      ],
      "libraryBooks": [
        {
          "id": "guides",
          "provider": "einayim-lamikra",
          "title": "עינים למקרא",
          "icon": "eye_24_regular",
          "when": {
            "storage": {
              "key": "mh_show_in_library",
              "notEquals": false
            }
          }
        }
      ]
    }
  }
}
